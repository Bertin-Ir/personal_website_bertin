---
import { experience, FULL_RESUME_URL } from '../data/resume';
import { skills } from '../data/skills';
import { skillMatcher } from '../lib/skillMatch';
import { experienceSlug } from '../lib/slug';

// Derived from data/resume.ts + data/skills.ts at build time.

const roleText = (exp: (typeof experience)[number]) =>
  [exp.role, exp.description ?? '', ...(exp.bullets ?? [])].join(' ');

const skillMatchers = skills.map((s) => ({ name: s.name, re: skillMatcher(s.name) }));
const matchSkills = (text: string) => skillMatchers.filter((m) => m.re.test(text)).map((m) => m.name);

// "MM/YYYY" -> "August 2026" for display, "2026-08" for <time datetime>.
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
function parseMonth(s?: string) {
  const m = s?.match(/^(\d{2})\/(\d{4})$/);
  if (!m) return { label: s ?? '', iso: undefined };
  return { label: `${MONTHS[Number(m[1]) - 1]} ${m[2]}`, iso: `${m[2]}-${m[1]}` };
}
function parsePeriod(period: string) {
  const [start, end] = period.split(/\s*[–-]\s*/);
  return { start: parseMonth(start), end: parseMonth(end), isCurrent: /present/i.test(end ?? '') };
}
const periodLabel = (period: string) => {
  const p = parsePeriod(period);
  return `${p.start.label} – ${p.end.label}`;
};

const roles = experience.map((exp) => ({
  ...exp,
  ...parsePeriod(exp.period),
  tech: exp.skills ?? matchSkills(roleText(exp)),
}));

const tabs = [
  { id: 'technical', label: 'Technical' },
  { id: 'other', label: 'Other' },
] as const;

// --- Career metrics header ---
const toMonths = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return y * 12 + (m - 1);
};
const now = new Date();
const earliest = experience.reduce((a, e) => (e.startDate < a ? e.startDate : a), experience[0].startDate);
const spanMonths = now.getFullYear() * 12 + now.getMonth() - toMonths(earliest);
const years = Math.floor(spanMonths / 12);
const yearsLabel = spanMonths % 12 === 0 ? `${years}` : `${years}+`;
const [earliestY, earliestM] = earliest.split('-');
const earliestLabel = `${MONTHS[Number(earliestM) - 1]} ${earliestY}`;

// Core stack: pinned picks first, then tech badges ranked by how many roles list them.
const PINNED_STACK = ['FastAPI', 'Kubernetes', 'Docker', 'Redis'];
const stackCounts = new Map<string, number>();
for (const r of roles) for (const t of r.tech) stackCounts.set(t, (stackCounts.get(t) ?? 0) + 1);
const rankedStack = [...stackCounts.entries()].sort((a, b) => b[1] - a[1]).map(([n]) => n);
const coreStack = [...PINNED_STACK, ...rankedStack.filter((n) => !PINNED_STACK.includes(n)).slice(0, 6)];

const domains = ['Backend/System design', 'Data Science', 'Infrastructure and DevOps'];

const skillKey = (s: string) => s.toLowerCase();
// Copy-as-Markdown uses the same worded dates as the page.
const experienceJson = JSON.stringify(experience.map((e) => ({ ...e, period: periodLabel(e.period) })));
---

<section class="timeline-page px-3 sm:px-4 lg:px-6 pt-8 pb-12 md:pb-16" aria-labelledby="tl-title">
  <div class="max-w-7xl mx-auto w-full min-w-0">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <h1 id="tl-title" class="text-2xl md:text-3xl font-bold text-[var(--ink)]">Work Experience</h1>
      <div class="tl-noprint flex flex-wrap items-center gap-2" role="group" aria-label="Quick actions">
        <a href={FULL_RESUME_URL} target="_blank" rel="noopener noreferrer" class="ds-btn ds-btn--accent">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Full Resume
        </a>
        <button type="button" class="ds-btn" data-action="copy-md">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Copy as Markdown
        </button>
        <button type="button" class="ds-btn" data-action="print">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Print / Export
        </button>
        <span class="tl-status font-mono text-xs" role="status" aria-live="polite"></span>
      </div>
    </div>

    <!-- Career metrics -->
    <dl class="tl-metrics-header grid grid-cols-2 md:grid-cols-4 gap-px rounded-2xl overflow-hidden mb-6">
      <div class="tl-metric">
        <dt>Years of experience</dt>
        <dd class="tl-metric-value">{yearsLabel}</dd>
        <dd class="tl-metric-sub">since <time datetime={earliest}>{earliestLabel}</time></dd>
      </div>
      <div class="tl-metric">
        <dt>Roles</dt>
        <dd class="tl-metric-value">{experience.length}</dd>
        <dd class="tl-metric-sub">{roles.filter((r) => r.isCurrent).length} current</dd>
      </div>
      <div class="tl-metric">
        <dt>Core stack</dt>
        <dd class="flex flex-wrap gap-1.5 mt-2">
          {coreStack.map((name) => (
            <a href="/skills/" class="tl-domain" data-skill={skillKey(name)}>{name}</a>
          ))}
        </dd>
      </div>
      <div class="tl-metric">
        <dt>Domains</dt>
        <dd class="flex flex-wrap gap-1.5 mt-2">
          {domains.map((d) => (
            <span class="tl-domain">{d}</span>
          ))}
        </dd>
      </div>
    </dl>

    <div class="tl-noprint flex flex-wrap items-center gap-2 mb-8" role="tablist" aria-label="Experience type">
      {tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          class="tl-tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${t.id}`}
          tabindex={i === 0 ? 0 : -1}
        >
          {t.label}
        </button>
      ))}
    </div>

    {tabs.map((t, ti) => (
      <section
        role="tabpanel"
        id={`panel-${t.id}`}
        class="tl-panel"
        aria-labelledby={`tab-${t.id}`}
        tabindex="0"
        hidden={ti !== 0}
      >
        <h2 class="tl-print-only">{t.label} experience</h2>
        <ol class="graph-rail relative">
          {roles.filter((r) => r.category === t.id).map((r, i) => (
            <li class="tl-item relative pl-8 pb-6 last:pb-0" style={`--tl-delay: ${i * 70}ms`}>
              <span
                class:list={['graph-node', r.isCurrent ? 'graph-node--current' : 'graph-node--past']}
                aria-hidden="true"
              ></span>
              <article id={experienceSlug(r)} class="ds-card rounded-2xl p-5 md:p-6 scroll-mt-28" aria-labelledby={`role-${t.id}-${i}`}>
                <header class="flex flex-wrap justify-between items-start gap-x-12 gap-y-2">
                  <div class="min-w-0">
                    <h3 id={`role-${t.id}-${i}`} class="tl-role text-lg md:text-xl font-bold leading-tight">{r.role}</h3>
                    <p class="tl-company text-sm font-medium mt-1">{r.company}</p>
                  </div>
                  <div class="flex flex-col items-start sm:items-end gap-1.5 shrink-0">
                    <p class:list={['tl-period font-mono text-xs whitespace-nowrap', { 'tl-period--current': r.isCurrent }]}>
                      {r.start.iso ? <time datetime={r.start.iso}>{r.start.label}</time> : r.start.label}
                      {' – '}
                      {r.end.iso ? <time datetime={r.end.iso}>{r.end.label}</time> : r.end.label}
                    </p>
                    <p class="tl-location text-xs">{r.location}</p>
                  </div>
                </header>


                {r.description && (
                  <p class="tl-body max-w-4xl text-sm leading-relaxed mt-4">{r.description}</p>
                )}
                {r.bullets && r.bullets.length > 0 && (
                  <ul class="tl-body max-w-4xl text-sm leading-relaxed space-y-2 mt-4">
                    {r.bullets.map((bullet) => (
                      <li class="flex gap-2">
                        <svg class="tl-chevron w-3.5 h-3.5 mt-[0.3rem] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" />
                        </svg>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {r.tech.length > 0 && (
                  <ul class="flex flex-wrap gap-1.5 mt-4" aria-label="Technologies mentioned">
                    {r.tech.map((name) => (
                      <li><a href="/skills/" class="ds-badge ds-badge--accent" data-skill={skillKey(name)}>{name}</a></li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <script type="application/json" id="experience-data" set:html={experienceJson}></script>
</section>

<style>
  .timeline-page {
    /* Aliases of the shared --ds-* tokens in global.css */
    --timeline-bg: var(--ds-bg);
    --timeline-border: var(--ds-border);
    --timeline-spine: rgba(255, 255, 255, 0.08);
    --timeline-node-current: var(--ds-accent);
    --timeline-node-past: var(--ds-accent-2);
    --timeline-heading: var(--ds-heading);
    --timeline-text: var(--ds-text);
    --timeline-muted: var(--ds-muted);
  }
  :global(:root:not(.dark)) .timeline-page {
    /* Light theme: the spine sits on the page surface, not a card */
    --timeline-spine: rgba(0, 0, 0, 0.12);
  }

  .timeline-page :is(a, button, summary):focus-visible {
    outline: 2px solid var(--timeline-node-current);
    outline-offset: 2px;
  }

  /* Buttons */
  .tl-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--timeline-border);
    background: var(--timeline-bg);
    color: var(--timeline-text);
    font-size: 0.875rem;
    font-weight: 500;
    transition: border-color 0.2s, color 0.2s, background-color 0.2s;
  }
  .tl-tab:hover {
    border-color: var(--timeline-node-current);
    color: var(--timeline-heading);
  }
  .tl-tab {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    min-height: 36px;
    padding: 0.375rem 0.75rem;
  }
  .tl-tab[aria-selected='true'] {
    color: var(--timeline-node-current);
    border-color: var(--timeline-node-current);
    background: rgba(var(--ds-accent-rgb), 0.08);
  }
  .tl-status {
    color: var(--timeline-node-past);
  }

  /* Metrics header */
  .tl-metrics-header {
    background: var(--timeline-border);
    border: 1px solid var(--timeline-border);
  }
  .tl-metric {
    background: var(--timeline-bg);
    padding: 1rem 1.25rem;
    min-width: 0;
  }
  .tl-metric dt {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--timeline-muted);
  }
  .tl-metric-value {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--timeline-heading);
    line-height: 1.2;
    margin-top: 0.25rem;
  }
  .tl-metric-sub {
    font-size: 0.75rem;
    color: var(--timeline-muted);
  }
  .tl-domain {
    font-size: 0.75rem;
    color: var(--timeline-text);
    border: 1px solid var(--timeline-border);
    border-radius: 9999px;
    padding: 0.125rem 0.5rem;
  }
  a.tl-domain:hover {
    color: var(--timeline-heading);
  }

  /* Cards */
  .tl-role {
    color: var(--timeline-heading);
  }
  .tl-company,
  .tl-location {
    color: var(--timeline-muted);
  }
  .tl-body {
    color: var(--timeline-text);
  }
  .tl-chevron {
    color: var(--timeline-node-past);
  }
  .tl-period {
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--timeline-border);
    color: var(--timeline-muted);
  }
  .tl-period--current {
    color: var(--timeline-node-current);
    border-color: rgba(var(--ds-accent-rgb), 0.5);
  }
  .tl-panel:focus-visible {
    outline: 2px solid var(--timeline-node-current);
    outline-offset: 4px;
    border-radius: 1rem;
  }
  .tl-print-only {
    display: none;
  }

  /* Timeline spine (existing graph-rail/graph-node pattern, recoloured) */
  .graph-rail::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background-color: var(--timeline-spine);
  }
  .graph-node {
    position: absolute;
    left: 0;
    top: 1.6rem;
    width: 15px;
    height: 15px;
    border-radius: 9999px;
    border: 2px solid var(--timeline-node-past);
    background-color: var(--timeline-node-past);
    opacity: 0.55;
    z-index: 1;
  }
  .graph-node--current {
    border-color: var(--timeline-node-current);
    background-color: var(--timeline-node-current);
    opacity: 1;
    box-shadow: 0 0 0 4px rgba(var(--ds-accent-rgb), 0.15), 0 0 14px rgba(var(--ds-accent-rgb), 0.7);
    animation: tl-node-glow 2.4s ease-in-out infinite;
  }
  @keyframes tl-node-glow {
    50% { box-shadow: 0 0 0 6px rgba(var(--ds-accent-rgb), 0.08), 0 0 22px rgba(var(--ds-accent-rgb), 0.9); }
  }

  /* Reveal */
  .tl-item {
    animation: tl-reveal 0.5s ease-out both;
    animation-delay: var(--tl-delay, 0ms);
  }
  @keyframes tl-reveal {
    from { opacity: 0; transform: translateY(8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-item,
    .graph-node--current {
      animation: none;
    }
  }

  /* Print / Export: light, high-contrast, no theme colours */
  @media print {
    /* Only the site nav: each role card's title row is also a <header> */
    :global(body > header),
    :global(#cognitive-loader),
    .tl-noprint {
      display: none !important;
    }
    :global(html),
    :global(body) {
      background: #fff !important;
      color: #000 !important;
    }
    :global(main) {
      padding-top: 0 !important;
    }
    .timeline-page {
      --ds-bg: #fff;
      --ds-border: #bbb;
      --ds-accent: #000;
      --ds-accent-2: #555;
      --ds-heading: #000;
      --ds-text: #111;
      --ds-muted: #333;
      --timeline-spine: #999;
      padding: 0;
      font-size: 11pt;
    }
    .timeline-page h1 {
      color: #000;
      margin-bottom: 0.5rem;
    }
    /* Print both tabs, each under its own heading */
    .tl-panel[hidden] {
      display: block !important;
    }
    .tl-print-only {
      display: block;
      font-size: 12pt;
      font-weight: 700;
      color: #000;
      margin: 0.75rem 0 0.5rem;
    }
    .tl-item {
      animation: none;
      padding-bottom: 0.5rem;
      break-inside: avoid;
    }
    .ds-card {
      padding: 0.5rem 0.75rem;
      border-radius: 0.5rem;
    }
    .graph-node,
    .graph-node--current {
      animation: none;
      box-shadow: none;
      opacity: 1;
      top: 0.9rem;
    }
    .ds-badge,
    .tl-period--current {
      color: #000;
      background: none;
      border-color: #999;
      backdrop-filter: none;
    }
    .tl-metrics-header {
      margin-bottom: 0.75rem;
    }
    .tl-metric {
      padding: 0.5rem 0.75rem;
    }
    .tl-metric-value {
      font-size: 1.25rem;
    }
  }
</style>

<script>
  type Entry = {
    role: string;
    company: string;
    location: string;
    period: string;
    description?: string;
    bullets?: string[];
  };

  const root = document.querySelector<HTMLElement>('.timeline-page');
  if (root) {
    const status = root.querySelector<HTMLElement>('.tl-status');

    // Tabs (WAI-ARIA tabs pattern, automatic activation): click/Enter/Space select,
    // Left/Right/Home/End move focus and select.
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next =
          e.key === 'ArrowRight' ? (i === last ? 0 : i + 1)
          : e.key === 'ArrowLeft' ? (i === 0 ? last : i - 1)
          : e.key === 'Home' ? 0
          : e.key === 'End' ? last
          : -1;
        if (next < 0) return;
        e.preventDefault();
        select(tabs[next], true);
      });
    });

    // Deep links (/resume/#<role-company>) may point into the hidden tab: reveal it, then scroll.
    const revealHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const target = id ? document.getElementById(id) : null;
      const panel = target?.closest<HTMLElement>('[role="tabpanel"]');
      if (!target || !panel) return;
      const tab = tabs.find((t) => t.getAttribute('aria-controls') === panel.id);
      if (tab && panel.hidden) select(tab);
      target.scrollIntoView({ block: 'start' });
    };
    revealHash();
    window.addEventListener('hashchange', revealHash);

    root.querySelectorAll('[data-action="print"]').forEach((b) => b.addEventListener('click', () => window.print()));

    const toMarkdown = (entries: Entry[]) =>
      [
        '## Work Experience',
        '',
        ...entries.flatMap((e) => [
          `- **${e.role}**, ${e.company} (${e.location}) · ${e.period}`,
          ...(e.description ? [`  - ${e.description}`] : []),
          ...(e.bullets ?? []).map((b) => `  - ${b}`),
        ]),
        '',
      ].join('\n');

    const announce = (msg: string) => {
      if (!status) return;
      status.textContent = msg;
      window.setTimeout(() => {
        if (status.textContent === msg) status.textContent = '';
      }, 2500);
    };

    const copyText = async (text: string) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return;
      }
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      if (!ok) throw new Error('copy failed');
    };

    root.querySelector('[data-action="copy-md"]')?.addEventListener('click', async () => {
      const raw = document.getElementById('experience-data')?.textContent;
      if (!raw) return;
      try {
        await copyText(toMarkdown(JSON.parse(raw) as Entry[]));
        announce('Copied');
      } catch {
        announce('Copy failed');
      }
    });
  }
</script>
