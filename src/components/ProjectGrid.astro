---
import type { Project } from '../data/projects';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;

// Render in data order: each horizontal project is its own full-width row, and runs of
// consecutive standard projects share a 2-column grid. Reorder data/projects.ts to move rows.
type Segment = { horizontal: boolean; items: Project[] };
const segments = projects.reduce<Segment[]>((acc, p) => {
  const horizontal = p.layout === 'horizontal';
  const last = acc[acc.length - 1];
  if (last && !horizontal && !last.horizontal) last.items.push(p);
  else acc.push({ horizontal, items: [p] });
  return acc;
}, []);

const showGithub = (p: Project) => Boolean(p.github) && !p.private;
---

<!-- Same container, panel tokens and ds-* components as the Work Experience page -->
<section class="px-3 sm:px-4 lg:px-6 pt-8 pb-12 md:pb-16" aria-labelledby="projects-title">
  <div class="max-w-7xl mx-auto w-full min-w-0">
    <h1 id="projects-title" class="text-2xl md:text-3xl font-bold text-[var(--ink)] mb-8">Projects</h1>

    <div class="flex flex-col gap-5">
    {segments.map((seg) => seg.horizontal ? (
      <ul class="flex flex-col gap-5">
        {seg.items.map((project) => (
          <li>
            <article
              class:list={[
                'ds-card rounded-2xl overflow-hidden',
                // Portrait images get a column sized to the image itself; others use a 3/2 split.
                project.imageFit === 'contain' ? 'flex flex-col md:flex-row' : 'grid grid-cols-1 md:grid-cols-5',
              ]}
              aria-labelledby={`project-${project.id}`}
            >
              <div class="md:col-span-3 flex-1 min-w-0 flex flex-col p-5 md:p-8">
                <h2 id={`project-${project.id}`} class="project-title scroll-mt-28 text-xl md:text-2xl font-bold leading-tight mb-3">
                  {project.title}
                </h2>
                <p class="project-body text-sm md:text-base leading-relaxed">{project.description}</p>
                {project.status && (
                  <p class="project-status mt-4 self-start inline-flex items-center gap-2 text-xs font-mono">
                    <span class="project-status-dot" aria-hidden="true"></span>
                    {project.status}
                  </p>
                )}
                {project.techStack.length > 0 && (
                  <ul class="flex flex-wrap gap-1.5 mt-4" aria-label="Tech stack">
                    {project.techStack.map((skill) => (
                      <li class="ds-badge" data-skill={skill.toLowerCase()}>{skill}</li>
                    ))}
                  </ul>
                )}
                {(showGithub(project) || project.liveUrl || project.demoVideoUrl) && (
                  <div class="mt-auto pt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
                    {showGithub(project) && (
                      <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="ds-btn"
                        aria-label={`View ${project.title} on GitHub`}
                      >
                        <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z" /></svg>
                        View on GitHub
                      </a>
                    )}
                    {project.liveUrl && (
                      <a
                        href={project.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="ds-btn ds-btn--accent"
                        aria-label={`Open live demo of ${project.title}`}
                      >
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                        Live Demo
                      </a>
                    )}
                    {project.demoVideoUrl && (
                      <a
                        href={project.demoVideoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="project-text-link text-sm font-medium"
                        aria-label={`Watch the demo video of ${project.title}`}
                      >
                        Watch the demo
                      </a>
                    )}
                  </div>
                )}
              </div>

              <div class:list={['md:col-span-2 flex', project.imageFit === 'contain' ? 'md:flex-none' : 'relative h-56 sm:h-64 md:h-auto md:min-h-[16rem]']}>
                {project.image ? (
                  <img
                    src={project.image}
                    alt={`${project.title} app screenshot`}
                    class:list={[
                      project.imageFit === 'contain'
                        ? 'block w-auto max-w-full h-auto max-h-[28rem] mx-auto md:max-h-none md:h-[26rem]'
                        : 'absolute inset-0 w-full h-full object-cover object-top',
                    ]}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="project-image-placeholder flex-1 m-4 md:m-5 rounded-xl flex items-center justify-center" aria-hidden="true">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    ) : (
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {seg.items.map((project) => (
        <li class="flex">
          <article class="ds-card flex flex-col w-full rounded-2xl p-5 md:p-6" aria-labelledby={`project-${project.id}`}>
            <div class="mb-5">
              <h2 id={`project-${project.id}`} class="project-title scroll-mt-28 text-lg md:text-xl font-bold leading-tight mb-3">
                {project.title}
              </h2>
              <p class="project-body text-sm leading-relaxed mb-4">{project.description}</p>
              {project.techStack.length > 0 && (
                <ul class="flex flex-wrap gap-1.5" aria-label="Tech stack">
                  {project.techStack.map((skill) => (
                    <li class="ds-badge" data-skill={skill.toLowerCase()}>{skill}</li>
                  ))}
                </ul>
              )}
            </div>

            <div class="mt-auto flex flex-wrap items-center gap-2">
              {showGithub(project) && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ds-btn"
                  aria-label={`View ${project.title} on GitHub`}
                >
                  <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z" /></svg>
                  View on GitHub
                </a>
              )}
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ds-btn ds-btn--accent"
                  aria-label={`Open live demo of ${project.title}`}
                >
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  Live Demo
                </a>
              )}
            </div>
          </article>
        </li>
      ))}
    </ul>
    ))}
    </div>
  </div>
</section>

<style>
  .project-title {
    color: var(--ds-highlight);
  }
  .project-body {
    color: var(--ds-text);
  }
  .project-text-link {
    color: var(--ds-highlight);
    text-decoration: underline;
    text-underline-offset: 3px;
    border-radius: 0.25rem;
  }
  .project-text-link:hover {
    color: var(--ds-heading);
  }
  .project-status {
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--ds-border);
    color: var(--ds-text);
  }
  .project-status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #fbbf24; /* amber: pending */
  }
  .project-image-placeholder {
    border: 2px dashed var(--ds-border);
    color: var(--ds-muted);
  }
</style>
