---
import NodeNetwork from './NodeNetwork.astro';
import DropoutNetwork from './DropoutNetwork.astro';

// Role line (subtitle), headline, then the intro (line 1 with name highlighted, line 3 supporting)
const roleLine = "Machine Learning engineer / Data Scientist / Software engineer";
const introLine1Prefix = "Hi there! I'm ";
const introName = "Bertin Iradukunda";
const introLine1Suffix = ", a CS and Applied Math student at NYU Abu Dhabi.";
const introLine2 = "Building intelligent systems that solve real problems.";
const introLine3 = "I bring hands-on experience in machine learning, data science, and software development. I design and build efficient, scalable solutions with speed, curiosity, and a genuine love.";
---

<section class="hero relative overflow-hidden min-h-[62vh] flex items-center justify-center px-4 sm:px-6 lg:px-8 pt-16 pb-10" aria-labelledby="hero-title">
  <NodeNetwork />
  <!-- Radial veil keeps the text legible over the node graph -->
  <div class="hero-veil absolute inset-0 z-[1] pointer-events-none" aria-hidden="true"></div>

  <!-- Left network | hero copy | right network (side columns hidden below lg) -->
  <div class="hero-grid relative z-[2] w-full items-center">
    <DropoutNetwork side="left" />
    <div class="min-w-0 max-w-3xl mx-auto text-center">
      <p class="hero-accent inline-block font-mono text-xs sm:text-sm tracking-wide mb-5">
        {roleLine}
      </p>
      <h1 id="hero-title" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--ink)] leading-tight mb-6">
        {introLine2}
      </h1>
      <p class="text-base md:text-lg text-[var(--ink)]/90 leading-snug mb-3">
        {introLine1Prefix}<span class="hero-accent font-semibold">{introName}</span>{introLine1Suffix}
      </p>
      <p class="text-base md:text-lg text-[var(--ink)]/75 leading-relaxed max-w-2xl mx-auto">
        {introLine3}
      </p>
    </div>
    <DropoutNetwork side="right" />
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 1024px) {
    .hero-grid {
      /* Centre column capped so the copy keeps its width; side columns take the rest. */
      grid-template-columns: minmax(180px, 1fr) minmax(500px, 600px) minmax(180px, 1fr);
      column-gap: 2.5rem;
    }
  }
  .hero-veil {
    background: radial-gradient(circle 550px at center, rgba(11, 13, 18, 0.82), rgba(11, 13, 18, 0));
  }
  :global(:root:not(.dark)) .hero-veil {
    background: radial-gradient(circle 550px at center, rgba(242, 247, 246, 0.88), rgba(242, 247, 246, 0));
  }
  .hero-accent {
    color: var(--ds-accent);
  }
</style>
