---
import { projects } from '../data/projects';
import { skills } from '../data/skills';
import { experience } from '../data/resume';

// Years research & applied: from the earliest experience start date to the build date (not hardcoded).
const earliestStart = experience.reduce((min, e) => (e.startDate < min ? e.startDate : min), experience[0].startDate);
const [startYear, startMonth] = earliestStart.split('-').map(Number);
const now = new Date();
const monthsSinceStart = (now.getFullYear() - startYear) * 12 + (now.getMonth() + 1 - startMonth);
const yearsSinceStart = Math.floor(monthsSinceStart / 12);

const stats = [
  { value: projects.length, suffix: '+', label: 'Projects shipped' },
  { value: yearsSinceStart, suffix: '+', label: 'Years experience' },
  { value: skills.length, suffix: '+', label: 'Technologies mastered' },
];
---

<section class="px-4 sm:px-6 lg:px-8 pt-6 pb-12 md:pb-16" aria-label="Highlights">
  <div class="w-full min-w-0">
    <dl class="stats-grid grid grid-cols-1 sm:grid-cols-3 gap-px rounded-2xl overflow-hidden">
      {stats.map((stat, i) => (
        <div class="stat-item flex flex-col-reverse items-center text-center px-5 py-6 md:py-8" data-value={stat.value}>
          <dt class="stat-label font-mono text-xs uppercase mt-2">{stat.label}</dt>
          <dd class:list={['stat-number font-mono text-3xl md:text-4xl font-medium', i % 2 ? 'stat-number--alt' : '']}>
            <span class="stat-value">{stat.value}</span>{stat.suffix}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  // Count up from 0 when the panel scrolls into view. The real value is in the HTML,
  // so without JS (or with reduced motion) the final numbers simply show.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.stat-item').forEach((item) => {
      const target = parseInt(item.dataset.value || '0', 10);
      const valEl = item.querySelector('.stat-value');
      if (!valEl) return;
      valEl.textContent = '0';
      const duration = 1500;
      const easeOutQuart = (t: number) => 1 - Math.pow(1 - t, 4);
      const animate = (start: number) => (ts: number) => {
        const progress = Math.min((ts - start) / duration, 1);
        valEl.textContent = String(Math.floor(target * easeOutQuart(progress)));
        if (progress < 1) requestAnimationFrame(animate(start));
        else valEl.textContent = String(target);
      };
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          requestAnimationFrame((ts) => animate(ts)(ts));
          observer.disconnect();
        }
      }, { threshold: 0.3 });
      observer.observe(item);
    });
  }
</script>

<style>
  /* Same divided-grid treatment as the Work Experience metrics header */
  .stats-grid {
    background: var(--ds-border);
    border: 1px solid var(--ds-border);
  }
  .stat-item {
    background: var(--ds-bg);
  }
  .stat-label {
    letter-spacing: 0.08em;
    color: var(--ds-muted);
  }
  .stat-number {
    color: var(--ds-accent);
    line-height: 1.1;
  }
  .stat-number--alt {
    color: var(--ds-accent-2);
  }
</style>
