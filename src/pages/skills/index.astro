---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { skills, type Skill } from '../../data/skills';
import { projects } from '../../data/projects';
import { experience } from '../../data/resume';
import { skillMatcher } from '../../lib/skillMatch';
import { experienceSlug, projectAnchor } from '../../lib/slug';

// Skills used together share one card; every other skill is its own card.
const GROUPS: string[][] = [
  ['C', 'C++'],
  ['Pandas', 'NumPy'],
  ['Matplotlib', 'Seaborn'],
  ['Scikit-Learn', 'PyTorch', 'Keras'],
  ['Dagster', 'Kubernetes', 'Docker', 'Kong'],
  ['HTML', 'CSS'],
];

// Single-colour outline icons (Heroicons v1 paths, 24x24, stroke).
const ICONS = {
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  database: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  chip: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  server: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01',
  terminal: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  beaker: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  table: 'M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  globe: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  // Filled GitHub mark (rendered with fill, not stroke; see FILLED_ICONS).
  github: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z',
  branch: 'M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z',
  cloud: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z',
  document: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  bolt: 'M13 10V3L4 14h7v7l9-11h-7z',
  calculator: 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z',
};
type IconName = keyof typeof ICONS;
const FILLED_ICONS = new Set<IconName>(['github']);

// Keyed by the card's first skill; anything unlisted falls back to its category's icon.
const CARD_ICON: Record<string, IconName> = {
  Python: 'code',
  C: 'code',
  MATLAB: 'calculator',
  SQL: 'database',
  HTML: 'globe',
  Dagster: 'server',
  Stata: 'chart',
  'Git/GitHub': 'github',
  PostgreSQL: 'database',
  'Node.js': 'terminal',
  'Google Colab': 'cloud',
  Arduino: 'chip',
  Excel: 'table',
  Notion: 'document',
  Pandas: 'table',
  Matplotlib: 'chart',
  'Scikit-Learn': 'beaker',
  FastAPI: 'bolt',
};
const CATEGORY_ICON: Record<Skill['category'], IconName> = {
  Languages: 'code',
  Technologies: 'server',
  'Libraries & Frameworks': 'beaker',
};

// Cards in data order: a group card appears where its first member does.
const grouped = new Map(GROUPS.flatMap((g) => g.map((name) => [name, g] as const)));
const seen = new Set<string>();
const cards = skills.flatMap((skill) => {
  if (seen.has(skill.name)) return [];
  const names = grouped.get(skill.name) ?? [skill.name];
  names.forEach((n) => seen.add(n));
  return [{ names, category: skill.category }];
});

// "Utilized in": projects whose techStack lists a member skill, and roles whose
// tagged skills or description/bullets mention one by name. Every match is listed and links to its entry.
function utilizedIn(names: string[]) {
  const res = names.map(skillMatcher);
  const hits = (text: string) => res.some((re) => re.test(text));
  const projectHits = projects
    .filter((p) => p.techStack.some(hits))
    .map((p) => ({ name: p.title, href: `/projects/#${projectAnchor(p.id)}` }));
  const roleHits = experience
    .filter((e) => (e.skills ?? []).some(hits) || hits([e.description ?? '', ...(e.bullets ?? [])].join(' ')))
    .map((e) => ({ name: e.role, href: `/resume/#${experienceSlug(e)}` }));
  return [...projectHits, ...roleHits];
}

// Section order on the page; each heading is rendered once above its cards.
const SECTIONS: Skill['category'][] = ['Languages', 'Libraries & Frameworks', 'Technologies'];

const cardData = cards.map((c) => {
  const used = utilizedIn(c.names);
  return {
    ...c,
    icon: CARD_ICON[c.names[0]] ?? CATEGORY_ICON[c.category],
    utilized: used,
  };
});
const sections = SECTIONS.map((title) => ({ title, cards: cardData.filter((c) => c.category === title) }))
  .filter((s) => s.cards.length > 0);
---
<BaseLayout title="Skills | Bertin" description="Skills — languages, tools, and ML/data stack">
  <!-- Same ds-* panel tokens and components as the Work Experience / Projects pages -->
  <section class="px-3 sm:px-4 lg:px-6 pt-8 pb-12 md:pb-16" aria-labelledby="skills-title">
    <div class="max-w-5xl mx-auto w-full min-w-0">
      <h1 id="skills-title" class="text-2xl md:text-3xl font-bold text-[var(--ink)] mb-8">Skills</h1>
      <div class="space-y-10">
        {sections.map((section) => (
          <section aria-labelledby={`skills-${section.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
            <div class="flex items-center gap-3 mb-5">
              <span class="skill-section-bar w-1 h-6 rounded-full" aria-hidden="true"></span>
              <h2 id={`skills-${section.title.toLowerCase().replace(/[^a-z]+/g, '-')}`} class="skill-section-title text-xl md:text-2xl font-bold">{section.title}</h2>
            </div>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-5">
              {section.cards.map((card) => (
                <li>
                  <article class="ds-card h-full rounded-2xl p-5 md:p-6 flex items-start gap-4">
                    <span class="skill-icon inline-flex items-center justify-center w-11 h-11 rounded-xl flex-shrink-0" aria-hidden="true">
                      {FILLED_ICONS.has(card.icon) ? (
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                          <path fill-rule="evenodd" clip-rule="evenodd" d={ICONS[card.icon]} />
                        </svg>
                      ) : (
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={ICONS[card.icon]} />
                        </svg>
                      )}
                    </span>
                    <div class="min-w-0">
                      <h3 class="skill-title text-base md:text-lg font-bold leading-tight">
                        {card.names.map((name, i) => (
                          <Fragment>
                            <span data-skill={name.toLowerCase()}>{name}</span>{i < card.names.length - 2 ? ', ' : i === card.names.length - 2 ? ' & ' : ''}
                          </Fragment>
                        ))}
                      </h3>
                      {card.utilized.length > 0 && (
                        <p class="text-sm leading-7 mt-2">
                          <span class="skill-used-label">Utilized in:</span>{' '}
                          <span class="skill-used-list">
                            {card.utilized.map((u, i) => (
                              <Fragment>
                                <a href={u.href} class="skill-used-link">{u.name}</a>{i < card.utilized.length - 1 ? ', ' : ''}
                              </Fragment>
                            ))}
                          </span>
                        </p>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Same tinted-cyan treatment as .ds-badge--accent */
  .skill-icon {
    color: var(--ds-accent);
    background: rgba(var(--ds-accent-rgb), 0.08);
    border: 1px solid rgba(var(--ds-accent-rgb), 0.25);
  }
  .skill-section-bar {
    background: var(--ds-accent-2);
  }
  .skill-section-title {
    color: var(--ink);
  }
  .skill-title {
    color: var(--ds-heading);
  }
  .skill-used-label {
    color: var(--ds-muted);
  }
  .skill-used-list {
    color: var(--ds-accent);
  }
  .skill-used-link {
    color: inherit;
    text-underline-offset: 2px;
    /* Inline padding grows the tap area without shifting the text */
    padding-block: 0.375rem;
  }
  .skill-used-link:hover,
  .skill-used-link:focus-visible {
    text-decoration: underline;
  }
</style>
