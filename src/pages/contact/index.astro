---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Formspree: create a form at https://formspree.io and set notification email to bi2067@nyu.edu, then paste the form action URL below.
const FORM_ENDPOINT = 'https://formspree.io/f/maqdnnpa';
---

<BaseLayout title="Contact | Bertin" description="Get in touch">
  <!-- Same ds-* panel tokens and components as the Work Experience / Projects pages -->
  <section class="px-3 sm:px-4 lg:px-6 pt-8 pb-12 md:pb-16" aria-labelledby="contact-title">
    <div class="max-w-xl mx-auto w-full min-w-0">
      <h1 id="contact-title" class="text-2xl md:text-3xl font-bold text-[var(--ink)] mb-2">Contact</h1>
      <p class="text-[var(--ink)]/70 mb-8">Let's build something meaningful!</p>

      <form action={FORM_ENDPOINT} method="POST" class="ds-card rounded-2xl p-5 md:p-6 space-y-5">
        <div>
          <label for="name" class="contact-label block font-mono text-xs uppercase mb-2">Name</label>
          <input type="text" id="name" name="name" required class="contact-input" placeholder="Your name" />
        </div>
        <div>
          <label for="email" class="contact-label block font-mono text-xs uppercase mb-2">Email</label>
          <input type="email" id="email" name="email" required class="contact-input" placeholder="you@example.com" />
        </div>
        <div>
          <label for="message" class="contact-label block font-mono text-xs uppercase mb-2">Message</label>
          <textarea id="message" name="message" rows="5" required class="contact-input resize-none" placeholder="Your message"></textarea>
        </div>
        <button type="submit" class="ds-btn ds-btn--accent w-full justify-center">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
          Send Message
        </button>
      </form>

      <div class="mt-10 pt-8 border-t border-[var(--ink)]/10">
        <p class="font-mono text-xs uppercase tracking-wider text-[var(--ink)]/60 mb-4">Or find me here:</p>
        <div class="flex items-center gap-3" aria-label="GitHub, Email, LinkedIn">
          <a href="https://github.com/Bertin-Ir" target="_blank" rel="noopener noreferrer" class="ds-btn contact-icon-btn" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
          </a>
          <a href="mailto:bi2067@nyu.edu" class="ds-btn contact-icon-btn" aria-label="Email">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/bertin-iradukunda-b14606250/" target="_blank" rel="noopener noreferrer" class="ds-btn contact-icon-btn" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-label {
    letter-spacing: 0.08em;
    color: var(--ds-muted);
  }
  .contact-input {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--ds-border);
    background: var(--ds-bg);
    color: var(--ds-heading);
    font-size: 1rem; /* 16px keeps iOS from zooming on focus */
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .contact-input::placeholder {
    color: var(--ds-muted);
    opacity: 0.7;
  }
  .contact-input:hover {
    border-color: rgba(var(--ds-accent-rgb), 0.35);
  }
  .contact-input:focus {
    outline: none;
    border-color: var(--ds-accent);
    box-shadow: 0 0 0 3px rgba(var(--ds-accent-rgb), 0.2);
  }
  /* Square icon-only variant of .ds-btn */
  .contact-icon-btn {
    justify-content: center;
    width: 44px;
    padding: 0;
  }
  .contact-icon-btn:hover {
    color: var(--ds-accent);
    background: rgba(var(--ds-accent-rgb), 0.08);
  }
</style>
